# Required
SITE_PASSWORD=your_secure_password

# Optional: Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Google Sheets API
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# Optional: AI features
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Optional: Telegram bot for Laporan Harian alerts/reports
# Store these in Vercel Environment Variables for production.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI_your_bot_token
TELEGRAM_DEFAULT_CHAT_ID=-1001234567890

